---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="That page is not here. Browse the writing archive or return to Rushabh Sanghvi’s Engineering Notes." canonicalPath="/404.html" noindex>
  <div class="shell page-width error-page">
    <p class="eyebrow">404 / A missing page</p>
    <h1>Nothing at this address.</h1>
    <p>The link may have changed, or the page may not have been published yet.</p>
    <a class="text-link" href="/writing/">Browse the writing <span aria-hidden="true">→</span></a>
    <a class="text-link" href="/">Go home <span aria-hidden="true">→</span></a>
  </div>
</BaseLayout>
